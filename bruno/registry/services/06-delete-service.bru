meta {
  name: Delete Service
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/services/{{serviceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

headers {
  X-Tenant-Id: {{tenantId}}
}

tests {
  test("status is 204", function() {
    expect(res.status).to.equal(204);
  });

  test("X-Trace-Id header is present", function() {
    expect(res.headers["x-trace-id"]).to.match(/^[0-9a-f]{32}$/);
  });
}
