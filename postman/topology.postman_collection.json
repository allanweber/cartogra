									"pm.test(\"error code is BAD_REQUEST\", function () {",
									"    pm.expect(pm.response.json().error.code).to.equal(\"BAD_REQUEST\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
