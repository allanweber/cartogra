{
  "info": {
    "name": "Cartogra Gateway",
    "description": "Gateway service API collection for Cartogra - authentication, OAuth, and admin endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway-url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"tenantId\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway-url}}/v1/auth/register",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test(\"response envelope present\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"data\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"traceId\");",
                  "});",
                  "",
                  "pm.test(\"traceId is 32 lowercase hex\", function () {",
                  "    pm.expect(pm.response.json().traceId).to.match(/^[0-9a-f]{32}$/);",
                  "});",
                  "",
                  "pm.test(\"X-Trace-Id header matches body traceId\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.equal(pm.response.json().traceId);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    pm.environment.set(\"registeredEmail\", pm.environment.get(\"testEmail\"));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
