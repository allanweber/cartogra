        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"tenantId\": \"{{tenantId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gateway-url}}/v1/auth/login",
              "host": [
                "{{gateway-url}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test(\"response envelope present\", function () {",
                  "    pm.expect(pm.response.json()).to.have.property(\"data\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"traceId\");",
                  "});",
                  "",
                  "pm.test(\"traceId is 32 lowercase hex\", function () {",
                  "    pm.expect(pm.response.json().traceId).to.match(/^[0-9a-f]{32}$/);",
                  "});",
                  "",
                  "pm.test(\"X-Trace-Id header matches body traceId\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Trace-Id\")).to.equal(pm.response.json().traceId);",
                  "});",
                  "",
                  "pm.test(\"accessToken is present\", function () {",
                  "    pm.expect(pm.response.json().data.accessToken).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"refreshToken is present\", function () {",
                  "    pm.expect(pm.response.json().data.refreshToken).to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "",
                  "pm.test(\"expiresIn is a positive number\", function () {",
                  "    pm.expect(pm.response.json().data.expiresIn).to.be.a(\"number\").and.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Set-Cookie jwt header is present\", function () {",
                  "    const setCookie = pm.response.headers.get(\"Set-Cookie\");",
                  "    pm.expect(setCookie).to.satisfy(function(v) {",
                  "        const cookies = Array.isArray(v) ? v : [v];",
                  "        return cookies.some(c => c.startsWith(\"jwt=\"));",
                  "    });",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"accessToken\", pm.response.json().data.accessToken);",
                  "    pm.environment.set(\"refreshToken\", pm.response.json().data.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
