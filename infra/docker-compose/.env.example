# Secrets for the deployable stack (docker-compose.yml). Copy this file to .env in this folder and set every value.
# docker compose refuses to start when a value is missing. The services refuse to start when JWT_SECRET,
# INTERNAL_TOKEN_KEY or BOOTSTRAP_ADMIN_PASSWORD is too short or is a published default.
#
#   cp .env.example .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   ...and the same for each line below.

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24   (Flyway connects as cartogra_owner)
CARTOGRA_OWNER_PASSWORD=
# openssl rand -hex 24   (the services connect as cartogra_app)
CARTOGRA_APP_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=
# openssl rand -base64 48   (at least 32 bytes)
JWT_SECRET=
# openssl rand -base64 48   (at least 32 bytes; not the same value as JWT_SECRET)
INTERNAL_TOKEN_KEY=
# 12+ characters; the admin of the demo tenant (admin@demo.invalid)
BOOTSTRAP_ADMIN_PASSWORD=
# openssl rand -base64 32   (AES key: 16, 24 or 32 bytes)
CLUSTER_CREDENTIALS_KEY=
