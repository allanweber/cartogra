# Root environment variables for local Cartogra development
# Copy this file to .env and update any secret values before running services.

# PostgreSQL
POSTGRES_USER=cartogra
POSTGRES_DB=cartogra
POSTGRES_PASSWORD=cartogra

# Redis / Valkey
REDIS_PASSWORD=cartogra

# Gateway application secrets
# At least 32 random bytes: openssl rand -base64 48. The gateway does not start with a placeholder.
JWT_SECRET=
# Signs the gateway-to-service and service-to-service tokens. All five JVM services need the same value.
# At least 32 random bytes, not the same value as JWT_SECRET: openssl rand -base64 48.
INTERNAL_TOKEN_KEY=
RESEND_API_KEY=re_placeholder
# Gateway uses RESEND_FROM. Contract reads RESEND_FROM_EMAIL.
RESEND_FROM=noreply@cartogra.dev
RESEND_FROM_EMAIL=noreply@cartogra.dev
RESEND_TEST_MODE=true
APP_BASE_URL=http://localhost:8080

# OAuth placeholders
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-base64-pem

# AI / intelligence service
CLAUDE_API_KEY=replace-with-claude-key

# Ingestion: AES key for SCM and cluster credentials (openssl rand -base64 32). Required.
# For local development only, ALLOW_PLAINTEXT_CREDENTIALS=true lets ingestion start without a key.
CLUSTER_CREDENTIALS_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Database — each service defaults to its own schema on localhost:5436 (docker-compose.dev.yml).
# Set DB_URL only when running one service at a time against another database.
# The services connect as cartogra_app (RLS applies); Flyway connects as cartogra_owner. The dev compose
# creates both roles on a new volume. For an old volume, run infra/helm/cartogra/charts/postgres/files/bootstrap-roles.sql once.
DB_USERNAME=cartogra_app
DB_PASSWORD=cartogra_app
FLYWAY_USERNAME=cartogra_owner
FLYWAY_PASSWORD=cartogra_owner

# Gateway runtime overrides
REDIS_HOST=localhost
REDIS_PORT=6380
REGISTRY_URI=http://localhost:8081
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional local convenience
PGADMIN_DEFAULT_EMAIL=admin@cartogra.dev
PGADMIN_DEFAULT_PASSWORD=cartogra
