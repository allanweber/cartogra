# Root environment variables for local Cartogra development
# Copy this file to .env and update any secret values before running services.

# PostgreSQL
POSTGRES_USER=cartogra
POSTGRES_DB=cartogra
POSTGRES_PASSWORD=cartogra

# Redis / Valkey
REDIS_PASSWORD=cartogra

# Gateway application secrets
JWT_SECRET=change-me-in-production-min-32-bytes
RESEND_API_KEY=re_placeholder
RESEND_FROM=noreply@cartogra.dev
RESEND_TEST_MODE=true
APP_BASE_URL=http://localhost:8080

# OAuth placeholders
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GITHUB_APP_ID=replace-with-github-app-id
GITHUB_APP_PRIVATE_KEY=replace-with-base64-pem

# AI / intelligence service
CLAUDE_API_KEY=replace-with-claude-key

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Gateway runtime overrides
DB_URL=jdbc:postgresql://localhost:5436/cartogra?currentSchema=registry
DB_USERNAME=cartogra
DB_PASSWORD=cartogra
REDIS_HOST=localhost
REDIS_PORT=6380
REGISTRY_URI=http://localhost:8081
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REGISTRY_GRPC_HOST=localhost
REGISTRY_GRPC_PORT=9091

# Optional local convenience
PGADMIN_DEFAULT_EMAIL=admin@cartogra.dev
PGADMIN_DEFAULT_PASSWORD=cartogra
