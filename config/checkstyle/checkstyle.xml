<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- allow @SuppressWarnings("checkstyle:RuleName") inline -->
    <module name="SuppressWarningsFilter"/>

    <!-- file-level suppressions (test method naming convention) -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Naming — mirrors CLAUDE.md backend rules -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <!-- UPPER_SNAKE_CASE, but allow idiomatic log/logger SLF4J fields -->
        <module name="ConstantName">
            <property name="format" value="^(log|logger|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <!-- Enforce Jackson 3: block com.fasterxml.jackson (use tools.jackson) -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="sun,com.fasterxml.jackson"/>
        </module>

        <!-- No silent empty catch blocks (never swallow exceptions) -->
        <module name="EmptyCatchBlock">
            <!-- allow: catch (Exception expected), catch (Exception _) -->
            <property name="exceptionVariableName" value="expected|ignored|_"/>
        </module>

        <!-- Always annotate method overrides -->
        <module name="MissingOverride"/>
    </module>
</module>
