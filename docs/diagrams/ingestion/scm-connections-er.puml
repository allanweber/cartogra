@startuml
title Ingestion — SCM Connections & Webhooks (V002 + V003)

entity "scm_connections" {
  * id : UUID <<PK>>
  --
  * tenant_id : UUID
  * provider : VARCHAR(50)
  * config : JSONB
  * sync_scheduler : BOOLEAN
  * poll_interval_minutes : INT
  ~ next_sync_at : TIMESTAMPTZ
  ~ last_sync_at : TIMESTAMPTZ
  ~ last_sync_status : TEXT
  * webhook_enabled : BOOLEAN
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  ~ deleted_at : TIMESTAMPTZ
}

entity "scm_webhooks" {
  * id : UUID <<PK>>
  --
  * tenant_id : UUID
  * scm_connection_id : UUID <<FK>>
  * provider : VARCHAR(50)
  ~ external_id : VARCHAR(255)
  * target_url : VARCHAR(2048)
  ~ webhook_secret : VARCHAR(2048)
  * events : VARCHAR(100)[]
  * status : VARCHAR(50)
  ~ last_received_at : TIMESTAMPTZ
  ~ error_message : VARCHAR(2000)
  * created_at : TIMESTAMPTZ
  * updated_at : TIMESTAMPTZ
  ~ deleted_at : TIMESTAMPTZ
}

scm_connections ||--o{ scm_webhooks : "scm_connection_id (logical, no DB FK)"

note bottom of scm_connections
  webhook_secret lives ONLY in scm_webhooks.
  next_sync_at drives the scheduler (partial index
  WHERE sync_scheduler = true AND deleted_at IS NULL).
end note
@enduml
