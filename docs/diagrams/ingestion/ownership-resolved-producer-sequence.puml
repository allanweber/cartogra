@startuml
title Ingestion — Ownership Resolved Producer Sequence

participant "ExecuteSyncUseCaseImpl" as UC
participant "ScmProvider" as SCM
participant "OwnershipResolvedProducer" as PROD
queue "cartogra.ingestion\n.ownership.resolved" as TOPIC

loop for each non-archived repository
    UC -> SCM: resolveOwnership(connectionConfig, repo)
    SCM --> UC: OwnershipMap(ownerTeams, pathOwners)
    UC -> PROD: publish(tenantId, connectionId, repo, ownership)
    PROD -> PROD: build OwnershipResolvedPayload\n(tenantId, connectionId, repo.fullPath(),\nownerTeams, pathOwners)
    PROD -> PROD: wrap in EventEnvelope.of(\n"ownership.resolved", connectionId, tenantId, 1, payload)
    PROD -> PROD: inject W3C traceparent header
    PROD -> TOPIC: send(key=repo.fullPath(), envelope)
end
@enduml
