@startuml
title Ingestion — Sync Command Idempotency Guard

queue "Kafka\ncartogra.registry.sync.command" as K
participant "SyncCommandConsumer" as C
participant "ExecuteSyncUseCaseImpl" as UC
participant "JdbcSyncJobRepository" as R
database "PostgreSQL\nsync_jobs" as DB

K -> C : ConsumerRecord (W3C traceparent header)
C -> C : extract traceparent → OTel Context
C -> UC : execute(SyncCommandPayload)

UC -> R : findRunningForConnection(tenantId, connectionId)
R -> DB : SELECT WHERE status='RUNNING' AND deleted_at IS NULL LIMIT 1

alt RUNNING job exists
    R --> UC : Optional.of(existingJob)
    UC -> UC : log WARN "Dropping duplicate sync command: connection=<uuid>"
    UC --> C : return existingJob (no new row)
else no RUNNING job
    R --> UC : Optional.empty()
    UC -> R : save(SyncJob{status=PENDING})
    R -> DB : INSERT sync_jobs
    UC -> R : markRunning(jobId)
    R -> DB : UPDATE status='RUNNING'
    UC -> UC : execute SCM sync...
    UC -> R : markCompleted(jobId, count)
    R -> DB : UPDATE status='COMPLETED'
end

@enduml
