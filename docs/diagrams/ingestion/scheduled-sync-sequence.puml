@startuml
title Ingestion — Scheduled Sync Tick (multi-instance safe)

participant "SyncScheduler\n@Scheduled tick" as SS
participant "ScmConnectionRepository" as R
participant "ScheduledSyncService\n(REQUIRES_NEW tx)" as TS
participant "AdvisoryLockRepository" as L
participant "SyncCommandProducer" as P
database PostgreSQL as DB
queue "cartogra.registry.sync.command" as K

SS -> R: findDue()
R -> DB: SELECT ... WHERE sync_scheduler\n  AND (next_sync_at IS NULL OR <= now())
DB --> R: due connections
R --> SS: List<ScmConnection>

loop for each due connection
  SS -> TS: attemptForConnection(conn)
  activate TS
  TS -> L: tryAcquireXactLock(conn.id MSB)
  L -> DB: SELECT pg_try_advisory_xact_lock(:key)
  alt lock acquired (this instance wins)
    DB --> L: true
    L --> TS: true
    TS -> P: publish(conn)
    P -> K: sync.command (+ traceparent)
  else lock held by another instance
    DB --> L: false
    L --> TS: false
    TS --> SS: (no-op)
  end
  deactivate TS
  SS -> R: updateSyncTimestamps(id, now, now+interval)
  R -> DB: UPDATE scm_connections
end

note over SS
  tick() is NOT transactional. Each connection is its own
  boundary; timestamp advance is outside the lock tx →
  at-least-once delivery (next tick retries on failure).
end note
@enduml
