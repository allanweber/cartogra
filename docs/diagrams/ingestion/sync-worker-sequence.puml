@startuml
title SCM Sync Worker — Sequence Diagram

actor Registry
participant "Kafka\ncartogra.registry.sync.command" as KafkaIn
participant "SyncCommandConsumer" as Consumer
participant "ExecuteSyncUseCaseImpl" as UseCase
participant "SyncJobRepository" as Repo
database "PostgreSQL\nsync_jobs" as DB
participant "ScmProvider\n(GitHub/AzDO)" as Provider
participant "SCM API" as SCM
participant "Kafka\ncartogra.ingestion.sync.completed" as KafkaOut

Registry -> KafkaIn : publish SyncCommand\n(connectionId, tenantId, providerType, config)
KafkaIn -> Consumer : consume(ConsumerRecord)
Consumer -> Consumer : extract W3C traceparent\nfrom Kafka headers
Consumer -> UseCase : execute(SyncCommandPayload)

UseCase -> Repo : save(SyncJob.create(...))
Repo -> DB : INSERT sync_jobs (PENDING)
UseCase -> Repo : markRunning(jobId)
Repo -> DB : UPDATE status=RUNNING

UseCase -> Provider : listRepositories(config)
Provider -> SCM : GET /orgs/{org}/repos
SCM --> Provider : repos[]
Provider --> UseCase : List<ScmRepository>

loop each non-archived repo
  UseCase -> Provider : resolveOwnership(config, repo)
  Provider -> SCM : GET CODEOWNERS
  SCM --> Provider : file contents
end

UseCase -> Repo : markCompleted(jobId, count)
Repo -> DB : UPDATE status=COMPLETED
UseCase -> KafkaOut : publishSuccess(job, count)

note over KafkaOut
  EventEnvelope<SyncResultPayload>
  with W3C traceparent header
end note

@enduml
