@startuml
title Sign-out flow (UserMenu.handleLogout)

actor User
participant "UserMenu\n(AppLayout)" as UM
participant "POST /api/auth/logout\n(Gateway)" as GW
participant "QueryClient\n(TanStack Query)" as QC
participant "sessionCookie\n(browser)" as SC
participant "useAuthStore\n(Zustand)" as AS
participant "TanStack Router" as Router

User -> UM: clicks "Sign out"
activate UM

UM -> GW: POST /api/auth/logout
alt server responds
  GW --> UM: 200 OK
else network error / 5xx
  GW --> UM: throws
  note right of UM: error is caught and swallowed\nflow continues regardless
end

UM -> QC: removeQueries({ queryKey: ['session'] })
note right of QC: stale session data\nno longer visible to\na subsequent user on the same tab

UM -> SC: clearSessionCookie()
UM -> AS: clearAuth()\nnote right of AS: user → null\nisAuthenticated → false

UM -> Router: navigate({ to: '/login' })
deactivate UM

@enduml
