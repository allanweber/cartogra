@startuml update-service-sequence
title Update Service — Use Case Flow

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam participantBackgroundColor #F8F8FF
skinparam participantBorderColor #444466
skinparam databaseBackgroundColor #FFFACD
skinparam databaseBorderColor #888800

actor Client
participant "ServiceController\n(api)" as C
participant "UpdateServiceUseCaseImpl\n(application)" as UC
participant "ServiceRepository\n(application)" as SR
participant "ServiceHistoryRepository\n(application)" as HR
database "PostgreSQL" as DB

Client -> C : PUT /api/v1/services/{id}\n{name?, description?, healthStatus?, ...}

activate C
C -> UC : execute(UpdateServiceCommand)
activate UC

UC -> SR : findById(tenantId, serviceId)
activate SR
SR -> DB : SELECT * FROM services\nWHERE id=? AND tenant_id=? AND deleted_at IS NULL
DB --> SR : row or empty
SR --> UC : Optional<Service>
deactivate SR

alt service not found
  UC --> C : throws ServiceNotFoundException
  C --> Client : 404 Not Found\n{"error":{"code":"SERVICE_NOT_FOUND",...}}
end

opt name changed
  UC -> SR : existsByName(tenantId, newName, serviceId)
  activate SR
  SR -> DB : SELECT count(*) WHERE lower(name)=?\nAND tenant_id=? AND id<>? AND deleted_at IS NULL
  DB --> SR : count
  SR --> UC : boolean
  deactivate SR

  alt name already taken by another service
    UC --> C : throws DuplicateServiceNameException
    C --> Client : 409 Conflict\n{"error":{"code":"CONFLICT",...}}
  end
end

UC -> UC : build updated Service record\n(patch command fields over existing;\nteamId unchanged; updatedAt=now())

UC -> SR : save(updated)
activate SR
SR -> DB : INSERT INTO services ... ON CONFLICT (id) DO UPDATE SET ...\nRETURNING *
DB --> SR : saved row
SR --> UC : Service
deactivate SR

UC -> UC : serialize Service → JSON snapshot

UC -> HR : save(ServiceSnapshot)
activate HR
HR -> DB : INSERT INTO services_history ...
DB --> HR : ok
HR --> UC : void
deactivate HR

UC --> C : Service
deactivate UC

C --> Client : 200 OK\n{"data": {service}, "traceId": "..."}
deactivate C

@enduml
