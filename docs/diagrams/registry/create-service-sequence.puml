@startuml create-service-sequence
title Create Service — Use Case Flow

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam participantBackgroundColor #F8F8FF
skinparam participantBorderColor #444466
skinparam databaseBackgroundColor #FFFACD
skinparam databaseBorderColor #888800

actor Client
participant "ServiceController\n(api)" as C
participant "CreateServiceUseCaseImpl\n(application)" as UC
participant "ServiceRepository\n(application)" as SR
participant "TeamRepository\n(application)" as TR
participant "ServiceHistoryRepository\n(application)" as HR
database "PostgreSQL" as DB

Client -> C : POST /api/v1/services\n{name, description, teamId?, ...}

activate C
C -> UC : execute(CreateServiceCommand)
activate UC

UC -> SR : existsByName(tenantId, name, null)
activate SR
SR -> DB : SELECT count(*) FROM services\nWHERE tenant_id=? AND lower(name)=? AND deleted_at IS NULL
DB --> SR : count
SR --> UC : boolean
deactivate SR

alt name already exists
  UC --> C : throws DuplicateServiceNameException
  C --> Client : 409 Conflict\n{"error":{"code":"CONFLICT",...}}
end

opt teamId provided
  UC -> TR : findById(tenantId, teamId)
  activate TR
  TR -> DB : SELECT * FROM teams\nWHERE id=? AND tenant_id=? AND deleted_at IS NULL
  DB --> TR : team row or empty
  TR --> UC : Optional<Team>
  deactivate TR

  alt team not found
    UC --> C : throws TeamNotFoundException
    C --> Client : 404 Not Found\n{"error":{"code":"TEAM_NOT_FOUND",...}}
  end
end

UC -> UC : build Service record\n(id=UUID.random, healthStatus=UNKNOWN, now())

UC -> SR : save(service)
activate SR
SR -> DB : INSERT INTO services ... ON CONFLICT (id) DO UPDATE\nRETURNING *
DB --> SR : saved row
SR --> UC : Service
deactivate SR

UC -> UC : serialize Service → JSON snapshot\n(ObjectMapper.writeValueAsString)

UC -> HR : save(ServiceSnapshot)
activate HR
HR -> DB : INSERT INTO services_history\n(id, service_id, tenant_id, snapshot, changed_by, changed_at)
DB --> HR : ok
HR --> UC : void
deactivate HR

UC --> C : Service
deactivate UC

C --> Client : 201 Created\n{"data": {service}, "traceId": "..."}
deactivate C

@enduml
