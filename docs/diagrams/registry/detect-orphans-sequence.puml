@startuml detect-orphans-sequence
title Detect Orphaned Services — Use Case Flow

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam participantBackgroundColor #F8F8FF
skinparam participantBorderColor #444466
skinparam databaseBackgroundColor #FFFACD
skinparam databaseBorderColor #888800

actor Client
participant "ServiceController\n(api)" as C
participant "DetectOrphansUseCaseImpl\n(application)" as UC
participant "ServiceRepository\n(application)" as SR
database "PostgreSQL" as DB

Client -> C : GET /api/v1/services/orphaned?limit=20&offset=0

activate C
C -> UC : execute(tenantId, limit, offset)
activate UC

UC -> SR : findOrphaned(tenantId, limit, offset)
activate SR
SR -> DB : SELECT s.* FROM services s\nWHERE s.tenant_id = :tenantId\nAND s.deleted_at IS NULL\nAND (\n  s.team_id IS NULL\n  OR NOT EXISTS (\n    SELECT 1 FROM teams t\n    WHERE t.id = s.team_id\n    AND t.deleted_at IS NULL\n  )\n)\nORDER BY s.updated_at DESC\nLIMIT :limit OFFSET :offset
DB --> SR : rows
SR --> UC : List<Service>
deactivate SR

UC -> SR : count(tenantId, ORPHAN filter)
activate SR
SR -> DB : SELECT count(*) (same WHERE clause)
DB --> SR : total
SR --> UC : long
deactivate SR

UC --> C : PageResult<Service>
deactivate UC

C --> Client : 200 OK\n{"data": {"items":[...],"total":N,"limit":20,"offset":0}, "traceId": "..."}
deactivate C

note over DB
  An orphan is a service where:
  1. team_id IS NULL, OR
  2. team_id references a soft-deleted team
  Both cases result from unassignment or team deletion.
end note

@enduml
