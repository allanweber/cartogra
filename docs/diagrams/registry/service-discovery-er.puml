@startuml
title Cartogra Registry — services table (discovery columns)

entity "services" {
  * id              : UUID <<PK>>
  --
  * tenant_id       : UUID
  * name            : TEXT
  ~ description     : TEXT
  ~ team_id         : UUID
  ~ repository_url  : TEXT
  ~ tech_stack      : TEXT (JSON array)
  ~ metadata        : JSONB
  * health_status   : TEXT
  ~ last_deployed_at: TIMESTAMPTZ
  * created_at      : TIMESTAMPTZ
  * updated_at      : TIMESTAMPTZ
  ~ deleted_at      : TIMESTAMPTZ
  .. discovery fields ..
  ~ external_id     : TEXT
  ~ connection_id   : UUID
  ~ source          : TEXT
  ~ repository_ref  : TEXT
  ~ k8s_cluster     : TEXT
  ~ k8s_namespace   : TEXT
  ~ k8s_deployment  : TEXT
  ~ health_endpoint : TEXT
  ~ last_commit_at  : TIMESTAMPTZ
  ~ last_commit_sha : TEXT
}

entity "services_history" {
  * id         : UUID <<PK>>
  --
  * service_id : UUID <<FK>>
  * tenant_id  : UUID
  * snapshot   : JSONB
  ~ changed_by : UUID
  * changed_at : TIMESTAMPTZ
}

services ||--o{ services_history : "snapshots"

@enduml
