@startuml assign-owner-sequence
title Assign Owner (team) to Service — Use Case Flow

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam participantBackgroundColor #F8F8FF
skinparam participantBorderColor #444466
skinparam databaseBackgroundColor #FFFACD
skinparam databaseBorderColor #888800

actor Client
participant "ServiceController\n(api)" as C
participant "AssignOwnerUseCaseImpl\n(application)" as UC
participant "ServiceRepository\n(application)" as SR
participant "TeamRepository\n(application)" as TR
participant "ServiceHistoryRepository\n(application)" as HR
database "PostgreSQL" as DB

Client -> C : PATCH /api/v1/services/{id}/owner\n{teamId} or {teamId: null}

activate C
C -> UC : execute(AssignOwnerCommand)
activate UC

UC -> SR : findById(tenantId, serviceId)
activate SR
SR -> DB : SELECT * FROM services\nWHERE id=? AND tenant_id=? AND deleted_at IS NULL
DB --> SR : row or empty
SR --> UC : Optional<Service>
deactivate SR

alt service not found
  UC --> C : throws ServiceNotFoundException
  C --> Client : 404 Not Found
end

opt teamId is not null (assigning a team)
  UC -> TR : findById(tenantId, teamId)
  activate TR
  TR -> DB : SELECT * FROM teams\nWHERE id=? AND tenant_id=? AND deleted_at IS NULL
  DB --> TR : row or empty
  TR --> UC : Optional<Team>
  deactivate TR

  alt team not found in this tenant
    UC --> C : throws TeamNotFoundException
    C --> Client : 404 Not Found\n{"error":{"code":"TEAM_NOT_FOUND",...}}
  end
end

note right of UC
  teamId=null means unassigning
  (service becomes an orphan)
end note

UC -> UC : build updated Service record\n(teamId = command.teamId, updatedAt=now())

UC -> SR : save(updated)
activate SR
SR -> DB : INSERT INTO services ... ON CONFLICT (id) DO UPDATE SET\nteam_id=:teamId, updated_at=now() RETURNING *
DB --> SR : saved row
SR --> UC : Service
deactivate SR

UC -> UC : serialize Service → JSON snapshot

UC -> HR : save(ServiceSnapshot)
activate HR
HR -> DB : INSERT INTO services_history ...
DB --> HR : ok
HR --> UC : void
deactivate HR

UC --> C : Service
deactivate UC

C --> Client : 200 OK\n{"data": {service}, "traceId": "..."}
deactivate C

@enduml
