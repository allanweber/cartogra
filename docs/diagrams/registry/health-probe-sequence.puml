@startuml
title Registry — Periodic Health Probe (Task 1.56)

participant "HealthProbeScheduler\n[@Scheduled PT60S]" as Sched
participant "ProbeServiceHealthUseCaseImpl" as UC
participant "JdbcAdvisoryLockRepository" as Lock
participant "ServiceRepository" as Repo
participant "RestClientHealthChecker" as Checker
participant "External\nHealth Endpoint" as Ext
database PostgreSQL as DB

Sched -> UC : probeAll()
UC -> Lock : tryAcquireLock(HEALTH_PROBE_LOCK_KEY)
Lock -> DB : SELECT pg_try_advisory_lock(:key)
DB --> Lock : true / false

alt lock not acquired (another replica is probing)
    UC --> Sched : return (skip round)
end

UC -> Repo : findAllWithHealthEndpoint()
Repo -> DB : SELECT * FROM services\nWHERE health_endpoint IS NOT NULL\n  AND source IS DISTINCT FROM 'kubernetes'\n  AND deleted_at IS NULL
DB --> Repo : List<Service>
Repo --> UC : probeable services

loop for each service
    UC -> Checker : check(service.healthEndpoint())
    Checker -> Ext : GET /health (timeout PT5S)

    alt 2xx response
        Ext --> Checker : HTTP 200
        Checker --> UC : HEALTHY
    else 401 or 403
        Ext --> Checker : HTTP 401/403
        Checker --> UC : PROBE_AUTH_FAILED
    else other 4xx / 5xx
        Ext --> Checker : HTTP 503
        Checker --> UC : DEGRADED
    else timeout / connection error
        Ext --> Checker : ResourceAccessException
        Checker --> UC : UNHEALTHY
    end

    UC -> Repo : updateHealth(tenantId, id, newStatus, now())
    Repo -> DB : UPDATE services\nSET health_status=?, health_checked_at=?, updated_at=?\nWHERE tenant_id=? AND id=?

    alt status transitioned (newStatus != previousStatus)
        UC -> UC : build ServiceSnapshot\n(in-memory Service with newStatus,\nchangedBy = SystemActors.SYSTEM)
        UC -> Repo : historyRepository.save(snapshot)
        Repo -> DB : INSERT INTO services_history ...
    end
end

UC -> Lock : releaseLock(HEALTH_PROBE_LOCK_KEY)
Lock -> DB : SELECT pg_advisory_unlock(:key)
@enduml
