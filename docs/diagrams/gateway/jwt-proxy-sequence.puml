@startuml
title Authenticated Request — JWT validation, tenant injection, registry proxy

actor Client
participant "RateLimitFilter" as RL
participant "JwtAuthWebFilter" as JF
participant "TenantInjectionFilter" as TF
participant "Spring Cloud Gateway" as GW
participant "Registry service" as RS
database Redis as RD

Client -> GW: GET /api/v1/services\n[Cookie: jwt=<token> OR Authorization: Bearer <token>]
GW -> RL: check rate limit (Redis token bucket)
RL -> RD: EVAL lua script — decrement token bucket

alt rate limit exceeded
  RL --> Client: 429 {error: {code: RATE_LIMITED}, traceId}\nX-Trace-Id: <traceId>
else within limit
  GW -> JF: extract token (cookie first, then Bearer header)
  alt no token
    JF -> GW: proceed unauthenticated
  else token present
    JF -> JF: NimbusJwtDecoder.decode(token)
    alt invalid / expired / tampered
      JF --> Client: 401 {error: {code: UNAUTHORIZED}, traceId}
    else valid
      JF -> JF: build JwtAuthentication(userId, tenantId, roles)
      JF -> GW: store in ReactiveSecurityContextHolder
    end
  end
  GW -> GW: Spring Security authorizeExchange check
  alt path requires auth and no principal
    GW --> Client: 401 {error: {code: UNAUTHORIZED}, traceId}
  else access denied by role
    GW --> Client: 403 {error: {code: ACCESS_DENIED}, traceId}
  else authorized
    GW -> TF: mutate request headers
    TF -> TF: REMOVE X-Tenant-Id from inbound headers
    TF -> TF: REMOVE X-User-Id from inbound headers
    TF -> TF: inject X-Tenant-Id = claims.tenantId (from JWT)
    TF -> TF: inject X-User-Id = claims.userId (from JWT)
    TF -> GW: forward mutated request
    GW -> RS: GET /api/v1/services\n[X-Tenant-Id, X-User-Id, traceparent]
    RS --> GW: 200 response
    GW -> GW: set X-Trace-Id on response
    GW --> Client: 200 {data: [...], traceId}\nX-Trace-Id: <traceId>
  end
end
@enduml
