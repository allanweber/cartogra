@startuml
title Login — Local email/password

actor Client
participant "AuthController" as AC
participant "LoginUseCase" as UC
participant "UserRepository" as UR
participant "JwtTokenProvider" as JWT
participant "RefreshTokenRepository" as RT
database PostgreSQL as DB

Client -> AC: POST /v1/auth/login\n{email, password, tenantId?}
AC -> UC: execute(tenantId, email, password)
UC -> UR: findByTenantAndEmail(tenantId, email)
UR -> DB: SELECT ... WHERE tenant_id = ? AND email = ? AND deleted_at IS NULL

alt not found or deleted
  UC --> AC: throw UnauthorizedException
  AC --> Client: 401 {error: {code: INVALID_CREDENTIALS}, traceId}
else user found
  UC -> UC: BCrypt.matches(password, passwordHash)
  alt wrong password
    UC --> AC: throw UnauthorizedException
    AC --> Client: 401 {error: {code: INVALID_CREDENTIALS}, traceId}
  else password matches
    alt emailVerified = false
      UC --> AC: throw UnverifiedEmailException
      AC --> Client: 401 {error: {code: UNVERIFIED_EMAIL}, traceId}
    else verified
      UC -> JWT: issueAccessToken(JwtClaims)
      UC -> UC: issueRefreshToken() — raw 64-char random
      UC -> UC: SHA-256 hash of raw refresh token
      UC -> RT: save(RefreshToken with hash, expiresAt=30d)
      RT -> DB: INSERT INTO refresh_tokens
      UC --> AC: TokenResponse(accessToken, refreshToken, expiresIn)
      AC -> AC: Set-Cookie: jwt=<access>\nHttpOnly; Secure; SameSite=Lax; Path=/; MaxAge=900
      AC -> AC: Set-Cookie: jwt_refresh=<refresh>\nHttpOnly; Secure; SameSite=Lax;\nPath=/v1/auth/refresh; MaxAge=2592000
      AC --> Client: 200 {data: TokenResponse, traceId}\nX-Trace-Id: <traceId>
    end
  end
end
@enduml
