root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,gradle,kts}]
indent_style = space
indent_size = 4

[*.{kt}]
indent_style = space
indent_size = 4

[*.{yaml,yml,json,ts,tsx,js,jsx,css,html}]
indent_style = space
indent_size = 2

[*.{xml,svg}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
